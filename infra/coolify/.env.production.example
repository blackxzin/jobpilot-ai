# JobPilot AI — Production Environment (copy to .env.production)
# Fill in your values before deploying

# ── Application ──────────────────────────────
APP_NAME=JobPilot AI
APP_ENV=production
APP_SECRET_KEY=<generate with: openssl rand -base64 32>
APP_API_V1_PREFIX=/api/v1
DOMAIN=jobpilot.ai

# ── Database ─────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=jobpilot
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=<set-a-strong-password>
DATABASE_URL=postgresql+asyncpg://jobpilot:<password>@postgres:5432/jobpilot

# ── Redis ────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ── Auth ─────────────────────────────────────
BETTER_AUTH_SECRET=<same-as-APP_SECRET_KEY>
BETTER_AUTH_URL=https://${DOMAIN}

# ── LLM Providers ────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434

# ── Celery ───────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Email ────────────────────────────────────
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=noreply@${DOMAIN}

# ── Notifications ────────────────────────────
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Monitoring ───────────────────────────────
SENTRY_DSN=
LOG_LEVEL=WARNING
