# ═══════════════════════════════════════════
# JobPilot AI — Environment Configuration
# Copy to .env and fill in your values
# ═══════════════════════════════════════════

# ── Application ──────────────────────────────
APP_NAME=JobPilot AI
APP_ENV=development
APP_SECRET_KEY=change-me-in-production-use-openssl-rand
APP_API_V1_PREFIX=/api/v1

# ── Database ─────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=jobpilot
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=jobpilot_secret
DATABASE_URL=postgresql+asyncpg://jobpilot:jobpilot_secret@postgres:5432/jobpilot

# ── Redis ────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ── Auth ─────────────────────────────────────
BETTER_AUTH_SECRET=change-me-in-production
BETTER_AUTH_URL=http://localhost:3000

# ── LLM Providers (default keys for dev) ────
# Users override these per-user in the database
OPENAI_API_KEY=sk-placeholder
NVIDIA_NIM_ENDPOINT=https://integrate.api.nvidia.com/v1
ANTHROPIC_API_KEY=sk-ant-placeholder
GEMINI_API_KEY=AIzaSy-placeholder
OPENROUTER_API_KEY=sk-or-v1-placeholder
OLLAMA_BASE_URL=http://ollama:11434

# ── Celery ───────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Email (for notifications) ────────────────
# Resend, SendGrid, or SMTP
EMAIL_PROVIDER=resend
EMAIL_API_KEY=sk-placeholder
EMAIL_FROM=noreply@jobpilot.ai

# ── Monitoring ────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=INFO
