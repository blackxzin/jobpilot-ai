# ═══════════════════════════════════════════
# JobPilot AI — Environment Configuration
# Copy to .env and fill in your values
# ═══════════════════════════════════════════

# ── Application ──────────────────────────────
APP_NAME=JobPilot AI
APP_ENV=development
# Used to derive the encryption key for stored LLM API keys — change it.
# Generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand
API_V1_PREFIX=/api/v1
# Where the backend redirects after a successful OAuth login
FRONTEND_URL=http://localhost:3000

# ── Database ─────────────────────────────────
# DATABASE_URL is derived from these values; setting it directly has no effect.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=jobpilot
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=jobpilot_secret

# ── Redis ────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ── Host ports (docker compose only) ─────────
# Change these if the default ports are already in use on your machine.
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=3000

# ── LLM Providers (default keys for dev) ────
# Users override these per-user in the database.
# Gerar chave em https://build.nvidia.com (modelo meta/llama-3.2-3b-instruct)
OPENAI_API_KEY=nvapi-CHANGE-ME
NVIDIA_NIM_ENDPOINT=https://integrate.api.nvidia.com/v1
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434

# ── Celery ───────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── Email (for notifications) ────────────────
# Resend, SendGrid, or SMTP
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=noreply@jobpilot.ai

# ── Notifications ────────────────────────────
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── LinkedIn OAuth ───────────────────────────
# Create an app at https://developer.linkedin.com — leave empty to disable
# the "Entrar com LinkedIn" button (the endpoint then returns 503).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/auth/linkedin/callback

# ── Monitoring ────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=INFO
